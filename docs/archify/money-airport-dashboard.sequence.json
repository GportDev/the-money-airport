{
  "schema_version": 1,
  "diagram_type": "sequence",
  "meta": {
    "title": "Open Dashboard",
    "subtitle": "Session cookie in, pre-aggregated widget payload out. No client-side ledger fold.",
    "output": "money-airport-dashboard.html",
    "viewBox": [820, 760],
    "quality_profile": "showcase",
    "views": [
      {
        "id": "session",
        "label": "Session gate",
        "focus": ["user", "spa", "api", "auth"],
        "note": "RequireSession reads GET /api/auth/session. Missing cookie redirects to /login?next=."
      },
      {
        "id": "compose",
        "label": "Compose widgets",
        "focus": ["api", "db", "fx"],
        "note": "DashboardModule reads snapshots, budget rollups, recent Transactions, and Recurring. FxModule converts KPIs to Base."
      },
      {
        "id": "render",
        "label": "Render cards",
        "focus": ["api", "spa", "user"],
        "note": "One DashboardPayload fills Budget, Net Worth, Spending, Transactions, Recurring. Credit Score stays omitted until a bureau is wired."
      }
    ]
  },
  "participants": [
