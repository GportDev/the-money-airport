    { "id": "api", "type": "backend", "label": "Dashboard", "sublabel": "composes modules" },
    { "id": "auth", "type": "security", "label": "BetterAuth", "sublabel": "cookie" },
    { "id": "db", "type": "database", "label": "Postgres", "sublabel": "snapshots" },
    { "id": "fx", "type": "cloud", "label": "FxModule", "sublabel": "fx_rate" }
