  "activations": [
    { "participant": "spa", "from": 175, "to": 628, "type": "frontend" },
    { "participant": "api", "from": 218, "to": 582, "type": "backend" },
    { "participant": "auth", "from": 251, "to": 298, "type": "security" },
    { "participant": "db", "from": 390, "to": 445, "type": "database" },
    { "participant": "fx", "from": 477, "to": 528, "type": "cloud" }
