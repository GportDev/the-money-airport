      {
        "id": "read-models",
        "label": "What pages read",
        "focus": ["snapshots", "transactions", "plans", "dashboard", "feed", "planning"],
        "note": "Widgets read snapshots and rollups. The feed paginates. Plan amounts are stored; Actuals are summed at read."
      }
    ]
