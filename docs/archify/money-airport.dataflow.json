  "cards": [
    {
      "dot": "emerald",
      "title": "Ledger rules",
      "items": [
        "Positive = income, negative = expense after ingest (Plaid signs are flipped)",
        "Every Transaction has a Category. Uncategorized is seeded and cannot be deleted",
        "Internal Transfer pairs are tagged and dropped from Budget, Spending, Reports, and Cash Flow totals"
      ]
    },
    {
      "dot": "rose",
      "title": "What stays out of totals",
      "items": [
        "Hidden BankAccounts skip net worth, Budget scope, and Goals",
        "Disconnect sets PlaidItem to disconnected and keeps history",
        "Crypto / unofficial codes are omitted from V1 Base totals"
      ]
    },
    {
      "dot": "orange",
      "title": "Read models",
      "items": [
        "DashboardModule composes Accounts, Budgets, Transactions, Recurring — it owns no extra tables",
        "Goal progress is associated BankAccount balances, not an envelope",
        "Recurring mark-paid / skip advance the schedule only; they do not insert a Transaction"
      ]
    }
  ]
}
